# .env.kbp.example — docker-compose.kbp.yml 용 환경 템플릿
#
# 복사해서 채운 뒤 사용:
#   cp .env.kbp.example .env.kbp
#   # 아래 값을 본인 키로 채운다
#   docker compose -f docker-compose.kbp.yml --env-file .env.kbp up -d
#
# .env.kbp 는 절대 git 에 커밋하지 말 것 (.gitignore 에 추가 권장).

# ── OpenRouter API 키 (필수) ─────────────────────────────────────────────
# edgequake 추출/질의 LLM(qwen) 호출에 사용. https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ── litellm 임베딩 키 (필수) ─────────────────────────────────────────────
# BGE-M3 임베딩(1024d) 호출에 사용.
LITELLM_API_KEY=sk-...

# ── 임베딩 엔드포인트 (선택, 기본값 있음) ─────────────────────────────────
# 기본: https://litellm.ax-demo.com/v1
# 자체 litellm/OpenAI 호환 임베딩 게이트웨이를 쓰면 여기서 덮어쓴다.
# EDGEQUAKE_EMBEDDING_BASE_URL=https://litellm.ax-demo.com/v1
